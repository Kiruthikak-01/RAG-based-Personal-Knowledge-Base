# API Keys for LLM providers
# DO NOT commit this file with actual keys to version control!

# Claude API (Anthropic)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Vector database location
CHROMA_DB_PATH=./chroma_db

# Optional: LLM Provider choice (claude or openai)
# LLM_PROVIDER=claude
# LLM_MODEL_NAME=claude-3-sonnet-20240229

# Optional: Embedding model (full model name from sentence-transformers)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
